@namespace("ch.admin.zammad.avro")
protocol UserProtocol {

	record User {
		long   id;
		string login;
		string email;
		string firstname;
		string lastname;
		union { null, string } image        = null;
		union { null, string } image_source = null;
		union { null, string } department   = null;
		union { null, string } organization_id = null;
		array<long>   organization_ids      = [];
		array<long>   role_ids              = [];
		array<string> roles                 = [];
		string  created_at;
		string  updated_at;
		string  created_by;
		string  updated_by;
		long    created_by_id;
		long    updated_by_id;
		boolean active;
		boolean verified;
		boolean vip;
		boolean out_of_office;
		union { null, string } out_of_office_start_at      = null;
		union { null, string } out_of_office_end_at        = null;
		union { null, long }   out_of_office_replacement_id = null;
		string phone   = "";
		string mobile  = "";
		string fax     = "";
		string web     = "";
		string street  = "";
		string city    = "";
		string zip     = "";
		string country = "";
		string note    = "";
		union { null, string } address = null;
		union { null, string } source  = null;
	}


}