@namespace("com.datamesh.customer.avro")
protocol CustomerProtocol {

	import idl "Address.avdl";
	import idl "Organization.avdl";

	record Customer {
		string id;
		string login;
		string email_address;
		union { null, string } first_name = null;
		string last_name;
		string phone_number;
		union { null, string } preferred_contact = null;
		union { null, string } segment = null;

		union { null, string } image        = null;
		union { null, string } image_source = null;
		union { null, string } department   = null;
		union { null, string } organization_id = null;

		boolean active;
		boolean verified;
		boolean vip;
		string mobile  = "";
		string fax     = "";
		string web     = "";
		string note    = "";
		union { null, string } address = null;

		array<Address> addresses;
		timestamp_ms onboarded_date;
	}
}
