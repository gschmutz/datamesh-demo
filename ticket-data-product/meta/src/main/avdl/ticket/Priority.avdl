@namespace("ch.admin.zammad.avro")
protocol PriorityProtocol {

  record Priority {
    long   id;
    string name;
    union { null, string } note     = null;
    union { null, string } ui_color = null;
    union { null, string } ui_icon  = null;
    boolean default_create;
    boolean active;
    string  created_at;
    string  updated_at;
    string  created_by;
    string  updated_by;
    long    created_by_id;
    long    updated_by_id;
  }

}