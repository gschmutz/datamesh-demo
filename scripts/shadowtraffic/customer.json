{
    "generators": [
        {
            "name": "genOrganizations",
            "connection": "customerWebhook",
            "vars": {
                "id": {
                    "_gen": "sequentialInteger",
                    "startingFrom": 1
                }
            },
            "url": "http://datamesh-customer-app:8082/api/organizations",
            "method": "POST",
            "data": {
                "id": {
                    "_gen": "var",
                    "var": "id"
                },
                "name": {
                    "_gen": "string",
                    "expr": "#{Company.name}"
                },
                "shared": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 3,
                            "value": true
                        },
                        {
                            "weight": 7,
                            "value": false
                        }
                    ]
                },
                "domain": {
                    "_gen": "string",
                    "expr": "#{Internet.domainName}"
                },
                "domainAssignment": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 5,
                            "value": true
                        },
                        {
                            "weight": 5,
                            "value": false
                        }
                    ]
                },
                "active": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 9,
                            "value": true
                        },
                        {
                            "weight": 1,
                            "value": false
                        }
                    ]
                },
                "vip": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 2,
                            "value": true
                        },
                        {
                            "weight": 8,
                            "value": false
                        }
                    ]
                },
                "note": {
                    "_gen": "string",
                    "expr": "#{Lorem.sentence}"
                },
                "memberIds": [],
                "secondaryMemberIds": []
            },
            "localConfigs": {
                "throttleMs": {
                    "_gen": "uniformDistribution",
                    "bounds": [
                        300000,
                        900000
                    ]
                }
            }
        },
        {
            "name": "genCustomers",
            "connection": "customerWebhook",
            "vars": {
                "id": {
                    "_gen": "uuid"
                },
                "organizationId": {
                    "_gen": "lookup",
                    "name": "genOrganizations",
                    "path": [
                        "data",
                        "id"
                    ]
                }
            },
            "url": "http://datamesh-customer-app:8082/api/customers",
            "method": "POST",
            "data": {
                "id": {
                    "_gen": "var",
                    "var": "id"
                },
                "organizationId": {
                    "_gen": "var",
                    "var": "organizationId"
                },
                "login": {
                    "_gen": "string",
                    "expr": "#{Name.username}"
                },
                "active": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 9,
                            "value": true
                        },
                        {
                            "weight": 1,
                            "value": false
                        }
                    ]
                },
                "verified": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 8,
                            "value": true
                        },
                        {
                            "weight": 2,
                            "value": false
                        }
                    ]
                },
                "vip": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 1,
                            "value": true
                        },
                        {
                            "weight": 9,
                            "value": false
                        }
                    ]
                },
                "firstName": {
                    "_gen": "string",
                    "expr": "#{Name.firstName}"
                },
                "lastName": {
                    "_gen": "string",
                    "expr": "#{Name.lastName}"
                },
                "emailAddress": {
                    "_gen": "string",
                    "expr": "#{Internet.emailAddress}"
                },
                "phoneNumber": {
                    "_gen": "string",
                    "expr": "#{PhoneNumber.cellPhoneInternational}"
                },
                "preferredContact": {
                    "_gen": "oneOf",
                    "choices": [
                        "email",
                        "phone"
                    ]
                },
                "segment": {
                    "_gen": "oneOf",
                    "choices": [
                        "bronze",
                        "silver",
                        "gold",
                        "platinum"
                    ]
                },
                "addresses": {
                    "_gen": "repeatedly",
                    "n": {
                        "_gen": "uniformDistribution",
                        "bounds": [
                            1,
                            5
                        ],
                        "decimals": 0
                    },
                    "target": {
                        "street": {
                            "_gen": "string",
                            "expr": "#{Address.streetName}"
                        },
                        "zipCode": {
                            "_gen": "string",
                            "expr": "#{Address.zipCode}"
                        },
                        "city": {
                            "_gen": "string",
                            "expr": "#{Address.city}"
                        },
                        "state": {
                            "_gen": "string",
                            "expr": "#{Team.state}"
                        }
                    }
                },
                "onboardedDate": {
                    "_gen": "now"
                }
            },
            "localConfigs": {
                "throttleMs": {
                    "_gen": "uniformDistribution",
                    "bounds": [
                        40000,
                        120000
                    ]
                }
            }
        }
    ],
    "schedule": {
        "stages": [
            {
                "generators": [
                    "genOrganizations"
                ],
                "overrides": {
                    "genOrganizations": {
                        "localConfigs": {
                            "maxEvents": 10,
                            "throttleMs": 0
                        }
                    }
                }
            },
            {
                "generators": [
                    "genCustomers"
                ],
                "overrides": {
                    "genCustomers": {
                        "localConfigs": {
                            "maxEvents": 300,
                            "throttleMs": 0
                        }
                    }
                }
            },
            {
                "generators": [
                    "genOrganizations",
                    "genCustomers"
                ]
            }
        ]
    },
    "connections": {
        "customerWebhook": {
            "kind": "webhook"
        }
    }
}
