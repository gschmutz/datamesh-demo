scalar DateTime
scalar Date
scalar Long

type Query {
    "List customers (default 50)."
    customers(limit: Int = 50): [Customer!]!
    "A single customer by id."
    customerById(id: ID!): Customer
}

type Customer {
    id: ID!
    login: String
    active: Boolean!
    verified: Boolean!
    vip: Boolean!
    firstName: String
    lastName: String
    emailAddress: String
    preferredContact: String
    segment: String
    dateOfBirth: Date
    preferredLanguage: String
    marketingConsent: Boolean!
    "PROSPECT, ACTIVE or CHURNED."
    lifecycleStatus: String
    "Avatar image reference."
    image: String
    "Source of the avatar image."
    imageSource: String
    department: String
    "Web site, empty when not set."
    web: String
    "Free-text note, empty when not set."
    note: String
    "Free-text address line kept for compatibility, structured addresses are in addresses."
    address: String
    onboardedDate: DateTime
    addresses: [Address!]!
    phones: [Phone!]!
    createdAt: DateTime
    updatedAt: DateTime
}

type Address {
    id: ID!
    street: String
    zipCode: String
    city: String
    state: String
    country: String
    "BILLING, SHIPPING or HOME."
    type: String
    createdAt: DateTime
    updatedAt: DateTime
}

type Phone {
    id: ID!
    "MOBILE, HOME, WORK or FAX."
    type: String
    number: String
    "When the customer is reachable on this number, e.g. Mon-Fri 09:00-17:00."
    availability: String
    createdAt: DateTime
    updatedAt: DateTime
}
