{
  "type" : "record",
  "name" : "CallEvent",
  "doc" : "One event per call handled by the Aristech AI-Suite.",
  "fields" : [ {
    "name" : "callID",
    "type" : "string",
    "doc" : "Identifier of the call as assigned by the Aristech AI-Suite."
  }, {
    "name" : "isAuthenticated",
    "type" : "boolean",
    "doc" : "Whether the caller was successfully authenticated during the call."
  }, {
    "name" : "isIdentified",
    "type" : "boolean",
    "doc" : "Whether the caller could be matched to a known customer."
  }, {
    "name" : "userData",
    "type" : {
      "type" : "record",
      "name" : "userData",
      "fields" : [ {
        "name" : "anliegen",
        "type" : "string",
        "doc" : "Free-text or classified reason for the call."
      }, {
        "name" : "bedrohung",
        "type" : "boolean",
        "doc" : "Flag indicating that a threat was detected or reported in the call."
      }, {
        "name" : "kundennummer",
        "type" : [ "null", "string" ],
        "doc" : "Customer number as stated by or resolved for the caller. Alphanumeric.",
        "default" : null
      }, {
        "name" : "plz",
        "type" : [ "null", "string" ],
        "doc" : "Postal code of the caller. Kept as string to preserve leading zeros.",
        "default" : null
      }, {
        "name" : "prio",
        "type" : "string",
        "doc" : "Priority assigned to the call, transmitted as a numeric string. Scale and direction TBC."
      }, {
        "name" : "socL",
        "type" : "boolean",
        "doc" : "Boolean flag with unknown meaning (TBC with producer)."
      } ]
    },
    "doc" : "Data captured from the caller during the call."
  } ]
}
