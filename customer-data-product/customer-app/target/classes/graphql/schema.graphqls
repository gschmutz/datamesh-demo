scalar DateTime
scalar Date
scalar Long

type Query {
    "List customers (default 50)."
    customers(limit: Int = 50): [Customer!]!
    "A single customer by id."
    customerById(id: ID!): Customer
}

type Mutation {
    "Onboard a customer and publish its state event. Returns the saved customer."
    onboardCustomer(input: CustomerInput!): Customer!
}

type Customer {
    id: ID!
    login: String
    active: Boolean!
    verified: Boolean!
    vip: Boolean!
    firstName: String
    lastName: String
    emailAddress: String
    preferredContact: String
    segment: String
    dateOfBirth: Date
    preferredLanguage: String
    marketingConsent: Boolean!
    "PROSPECT, ACTIVE or CHURNED."
    lifecycleStatus: String
    onboardedDate: DateTime
    addresses: [Address!]!
    phones: [Phone!]!
    createdAt: DateTime
    updatedAt: DateTime
}

type Address {
    id: ID!
    street: String
    zipCode: String
    city: String
    state: String
    country: String
    "BILLING, SHIPPING or HOME."
    type: String
}

input CustomerInput {
    id: ID!
    login: String
    active: Boolean = true
    verified: Boolean = false
    vip: Boolean = false
    firstName: String
    lastName: String
    emailAddress: String
    preferredContact: String
    segment: String
    dateOfBirth: Date
    preferredLanguage: String
    marketingConsent: Boolean = false
    lifecycleStatus: String
    addresses: [AddressInput!] = []
    phones: [PhoneInput!] = []
}

type Phone {
    id: ID!
    "MOBILE, HOME, WORK or FAX."
    type: String
    number: String
    "When the customer is reachable on this number, e.g. Mon-Fri 09:00-17:00."
    availability: String
}

input PhoneInput {
    type: String
    number: String!
    availability: String
}

input AddressInput {
    street: String
    zipCode: String
    city: String
    state: String
    country: String
    "BILLING, SHIPPING or HOME."
    type: String
}
