scalar DateTime
scalar Long

type Query {
    "List customers (default 50)."
    customers(limit: Int = 50): [Customer!]!
    "A single customer by id."
    customerById(id: ID!): Customer
}

type Mutation {
    "Onboard a customer and publish its state event. Returns the saved customer."
    onboardCustomer(input: CustomerInput!): Customer!
}

type Customer {
    id: ID!
    login: String
    active: Boolean!
    verified: Boolean!
    vip: Boolean!
    firstName: String
    lastName: String
    emailAddress: String
    phoneNumber: String
    preferredContact: String
    segment: String
    onboardedDate: DateTime
    addresses: [Address!]!
    createdAt: DateTime
    updatedAt: DateTime
}

type Address {
    id: ID!
    street: String
    zipCode: String
    city: String
    state: String
}

input CustomerInput {
    id: ID!
    login: String
    active: Boolean = true
    verified: Boolean = false
    vip: Boolean = false
    firstName: String
    lastName: String
    emailAddress: String
    phoneNumber: String
    preferredContact: String
    segment: String
    addresses: [AddressInput!] = []
}

input AddressInput {
    street: String
    zipCode: String
    city: String
    state: String
}
