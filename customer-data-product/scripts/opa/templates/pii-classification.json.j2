{#- Renders the classified properties of the GraphQL ODCS contract as OPA data.
    Loaded by OPAL at /datamesh/customer/pii/classification (see OPAL_DATA_CONFIG_SOURCES).
    datacontract export custom --template templates/pii-classification.json.j2 \
      --output rego/pii-classification-data.json ../../meta/odcs/customer-dp-graphql.odcs.yaml -#}
{% set ns = namespace(types=[]) -%}
{% for s in data_contract.schema_ -%}
{%- set ns2 = namespace(fields=[]) -%}
{%- for p in s.properties -%}
{%- if p.classification -%}{% set ns2.fields = ns2.fields + ['"' ~ p.name ~ '": "' ~ p.classification ~ '"'] %}{%- endif -%}
{%- endfor -%}
{%- if ns2.fields %}{% set ns.types = ns.types + ['"' ~ s.name ~ '": {' ~ ns2.fields | join(', ') ~ '}'] %}{% endif -%}
{%- endfor -%}
{{ '{' }}{{ ns.types | join(', ') }}{{ '}' }}
