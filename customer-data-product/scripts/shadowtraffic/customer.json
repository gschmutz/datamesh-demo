{
    "generators": [
        {
            "name": "genCustomers",
            "connection": "customerWebhook",
            "vars": {
                "id": {
                    "_gen": "uuid"
                }
            },
            "url": "http://datamesh-customer-app:8082/api/customers",
            "method": "POST",
            "data": {
                "id": {
                    "_gen": "var",
                    "var": "id"
                },
                "login": {
                    "_gen": "string",
                    "expr": "#{Name.username}"
                },
                "active": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 9,
                            "value": true
                        },
                        {
                            "weight": 1,
                            "value": false
                        }
                    ]
                },
                "verified": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 8,
                            "value": true
                        },
                        {
                            "weight": 2,
                            "value": false
                        }
                    ]
                },
                "vip": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 1,
                            "value": true
                        },
                        {
                            "weight": 9,
                            "value": false
                        }
                    ]
                },
                "firstName": {
                    "_gen": "string",
                    "expr": "#{Name.firstName}"
                },
                "lastName": {
                    "_gen": "string",
                    "expr": "#{Name.lastName}"
                },
                "emailAddress": {
                    "_gen": "string",
                    "expr": "#{Internet.emailAddress}"
                },
                "phones": {
                    "_gen": "repeatedly",
                    "n": {
                        "_gen": "uniformDistribution",
                        "bounds": [
                            1,
                            3
                        ],
                        "decimals": 0
                    },
                    "target": {
                        "type": {
                            "_gen": "oneOf",
                            "choices": [
                                "MOBILE",
                                "HOME",
                                "WORK",
                                "FAX"
                            ]
                        },
                        "number": {
                            "_gen": "string",
                            "expr": "+49 #{regexify '1[567][0-9] [0-9]{7,8}'}"
                        },
                        "availability": {
                            "_gen": "oneOf",
                            "choices": [
                                "Mon-Fri 09:00-17:00",
                                "Mon-Fri 17:00-21:00",
                                "Mon-Sun 08:00-20:00",
                                "Sat-Sun 10:00-16:00"
                            ]
                        }
                    }
                },
                "preferredContact": {
                    "_gen": "oneOf",
                    "choices": [
                        "email",
                        "phone"
                    ]
                },
                "segment": {
                    "_gen": "oneOf",
                    "choices": [
                        "bronze",
                        "silver",
                        "gold",
                        "platinum"
                    ]
                },
                "dateOfBirth": {
                    "_gen": "formatDateTime",
                    "ms": {
                        "_gen": "subtract",
                        "args": [
                            {
                                "_gen": "now"
                            },
                            {
                                "_gen": "uniformDistribution",
                                "bounds": [
                                    568080000000,
                                    2524608000000
                                ],
                                "decimals": 0
                            }
                        ]
                    },
                    "format": "yyyy-MM-dd"
                },
                "preferredLanguage": {
                    "_gen": "oneOf",
                    "choices": [
                        "en",
                        "de",
                        "fr",
                        "it"
                    ]
                },
                "marketingConsent": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 6,
                            "value": true
                        },
                        {
                            "weight": 4,
                            "value": false
                        }
                    ]
                },
                "lifecycleStatus": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 1,
                            "value": "PROSPECT"
                        },
                        {
                            "weight": 7,
                            "value": "ACTIVE"
                        },
                        {
                            "weight": 2,
                            "value": "CHURNED"
                        }
                    ]
                },
                "addresses": {
                    "_gen": "repeatedly",
                    "n": {
                        "_gen": "uniformDistribution",
                        "bounds": [
                            1,
                            5
                        ],
                        "decimals": 0
                    },
                    "target": {
                        "street": {
                            "_gen": "string",
                            "expr": "#{Address.streetName}"
                        },
                        "zipCode": {
                            "_gen": "string",
                            "expr": "#{Address.zipCode}"
                        },
                        "city": {
                            "_gen": "string",
                            "expr": "#{Address.city}"
                        },
                        "state": {
                            "_gen": "string",
                            "expr": "#{Team.state}"
                        },
                        "country": {
                            "_gen": "string",
                            "expr": "#{Address.countryCode}"
                        },
                        "type": {
                            "_gen": "oneOf",
                            "choices": [
                                "BILLING",
                                "SHIPPING",
                                "HOME"
                            ]
                        }
                    }
                },
                "onboardedDate": {
                    "_gen": "now"
                }
            },
            "localConfigs": {
                "throttleMs": {
                    "_gen": "uniformDistribution",
                    "bounds": [
                        40000,
                        120000
                    ]
                }
            }
        }
    ],
    "schedule": {
        "stages": [
            {
                "generators": [
                    "genCustomers"
                ],
                "overrides": {
                    "genCustomers": {
                        "localConfigs": {
                            "maxEvents": 300,
                            "throttleMs": 0
                        }
                    }
                }
            },
            {
                "generators": [
                    "genCustomers"
                ]
            }
        ]
    },
    "connections": {
        "customerWebhook": {
            "kind": "webhook"
        }
    }
}
