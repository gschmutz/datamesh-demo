{
    "generators": [
        {
            "name": "genSegments",
            "connection": "customerDb",
            "table": "customer.segment",
            "row": {
                "id": {
                    "_gen": "sequentialInteger"
                },
                "name": {
                    "_gen": "loop",
                    "n": 1,
                    "over": [
                        "bronze",
                        "silver",
                        "gold",
                        "platinum"
                    ]
                },
                "created_at": {
                    "_gen": "formatDateTime",
                    "ms": {
                        "_gen": "now"
                    },
                    "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'"
                },
                "modified_at": {
                    "_gen": "formatDateTime",
                    "ms": {
                        "_gen": "now"
                    },
                    "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'"
                }
            },
            "localConfigs": {
                "maxEvents": 4,
                "throttleMs": 0
            }
        },
        {
            "name": "genPhoneTypes",
            "connection": "customerDb",
            "table": "customer.phone_type",
            "row": {
                "id": {
                    "_gen": "sequentialInteger"
                },
                "name": {
                    "_gen": "loop",
                    "n": 1,
                    "over": [
                        "MOBILE",
                        "HOME",
                        "WORK",
                        "FAX"
                    ]
                },
                "created_at": {
                    "_gen": "formatDateTime",
                    "ms": {
                        "_gen": "now"
                    },
                    "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'"
                },
                "modified_at": {
                    "_gen": "formatDateTime",
                    "ms": {
                        "_gen": "now"
                    },
                    "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'"
                }
            },
            "localConfigs": {
                "maxEvents": 4,
                "throttleMs": 0
            }
        },
        {
            "name": "genAddressTypes",
            "connection": "customerDb",
            "table": "customer.address_type",
            "row": {
                "id": {
                    "_gen": "sequentialInteger"
                },
                "name": {
                    "_gen": "loop",
                    "n": 1,
                    "over": [
                        "BILLING",
                        "SHIPPING",
                        "HOME"
                    ]
                },
                "created_at": {
                    "_gen": "formatDateTime",
                    "ms": {
                        "_gen": "now"
                    },
                    "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'"
                },
                "modified_at": {
                    "_gen": "formatDateTime",
                    "ms": {
                        "_gen": "now"
                    },
                    "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'"
                }
            },
            "localConfigs": {
                "maxEvents": 3,
                "throttleMs": 0
            }
        },
        {
            "name": "genCountries",
            "connection": "customerDb",
            "table": "customer.country",
            "row": {
                "code": {
                    "_gen": "loop",
                    "n": 1,
                    "over": [
                        "AL",
                        "AD",
                        "AT",
                        "BY",
                        "BE",
                        "BA",
                        "BG",
                        "HR",
                        "CY",
                        "CZ",
                        "DK",
                        "EE",
                        "FI",
                        "FR",
                        "DE",
                        "GR",
                        "HU",
                        "IS",
                        "IE",
                        "IT",
                        "XK",
                        "LV",
                        "LI",
                        "LT",
                        "LU",
                        "MT",
                        "MD",
                        "MC",
                        "ME",
                        "NL",
                        "MK",
                        "NO",
                        "PL",
                        "PT",
                        "RO",
                        "RU",
                        "SM",
                        "RS",
                        "SK",
                        "SI",
                        "ES",
                        "SE",
                        "CH",
                        "UA",
                        "GB",
                        "VA"
                    ]
                },
                "name": {
                    "_gen": "loop",
                    "n": 1,
                    "over": [
                        "Albania",
                        "Andorra",
                        "Austria",
                        "Belarus",
                        "Belgium",
                        "Bosnia and Herzegovina",
                        "Bulgaria",
                        "Croatia",
                        "Cyprus",
                        "Czechia",
                        "Denmark",
                        "Estonia",
                        "Finland",
                        "France",
                        "Germany",
                        "Greece",
                        "Hungary",
                        "Iceland",
                        "Ireland",
                        "Italy",
                        "Kosovo",
                        "Latvia",
                        "Liechtenstein",
                        "Lithuania",
                        "Luxembourg",
                        "Malta",
                        "Moldova",
                        "Monaco",
                        "Montenegro",
                        "Netherlands",
                        "North Macedonia",
                        "Norway",
                        "Poland",
                        "Portugal",
                        "Romania",
                        "Russia",
                        "San Marino",
                        "Serbia",
                        "Slovakia",
                        "Slovenia",
                        "Spain",
                        "Sweden",
                        "Switzerland",
                        "Ukraine",
                        "United Kingdom",
                        "Vatican City"
                    ]
                },
                "created_at": {
                    "_gen": "formatDateTime",
                    "ms": {
                        "_gen": "now"
                    },
                    "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'"
                },
                "modified_at": {
                    "_gen": "formatDateTime",
                    "ms": {
                        "_gen": "now"
                    },
                    "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'"
                }
            },
            "localConfigs": {
                "maxEvents": 46,
                "throttleMs": 0
            }
        },
        {
            "name": "genCustomers",
            "connection": "customerWebhook",
            "vars": {
                "id": {
                    "_gen": "uuid"
                }
            },
            "url": "http://datamesh-customer-app:8082/api/customers",
            "method": "POST",
            "data": {
                "id": {
                    "_gen": "var",
                    "var": "id"
                },
                "login": {
                    "_gen": "string",
                    "expr": "#{Name.username}"
                },
                "active": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 9,
                            "value": true
                        },
                        {
                            "weight": 1,
                            "value": false
                        }
                    ]
                },
                "verified": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 8,
                            "value": true
                        },
                        {
                            "weight": 2,
                            "value": false
                        }
                    ]
                },
                "vip": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 1,
                            "value": true
                        },
                        {
                            "weight": 9,
                            "value": false
                        }
                    ]
                },
                "firstName": {
                    "_gen": "string",
                    "expr": "#{Name.firstName}"
                },
                "lastName": {
                    "_gen": "string",
                    "expr": "#{Name.lastName}"
                },
                "emailAddress": {
                    "_gen": "string",
                    "expr": "#{Internet.emailAddress}"
                },
                "phones": {
                    "_gen": "repeatedly",
                    "n": {
                        "_gen": "uniformDistribution",
                        "bounds": [
                            1,
                            3
                        ],
                        "decimals": 0
                    },
                    "target": {
                        "phoneTypeId": {
                            "_gen": "lookup",
                            "connection": "customerDb",
                            "table": "customer.phone_type",
                            "path": [
                                "row",
                                "id"
                            ]
                        },
                        "number": {
                            "_gen": "string",
                            "expr": "+49 #{regexify '1[567][0-9] [0-9]{7,8}'}"
                        },
                        "availability": {
                            "_gen": "oneOf",
                            "choices": [
                                "Mon-Fri 09:00-17:00",
                                "Mon-Fri 17:00-21:00",
                                "Mon-Sun 08:00-20:00",
                                "Sat-Sun 10:00-16:00"
                            ]
                        }
                    }
                },
                "preferredContact": {
                    "_gen": "oneOf",
                    "choices": [
                        "email",
                        "phone"
                    ]
                },
                "segmentId": {
                    "_gen": "lookup",
                    "connection": "customerDb",
                    "table": "customer.segment",
                    "path": [
                        "row",
                        "id"
                    ]
                },
                "dateOfBirth": {
                    "_gen": "formatDateTime",
                    "ms": {
                        "_gen": "subtract",
                        "args": [
                            {
                                "_gen": "now"
                            },
                            {
                                "_gen": "uniformDistribution",
                                "bounds": [
                                    568080000000,
                                    2524608000000
                                ],
                                "decimals": 0
                            }
                        ]
                    },
                    "format": "yyyy-MM-dd"
                },
                "preferredLanguage": {
                    "_gen": "oneOf",
                    "choices": [
                        "en",
                        "de",
                        "fr",
                        "it"
                    ]
                },
                "marketingConsent": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 6,
                            "value": true
                        },
                        {
                            "weight": 4,
                            "value": false
                        }
                    ]
                },
                "lifecycleStatus": {
                    "_gen": "weightedOneOf",
                    "choices": [
                        {
                            "weight": 1,
                            "value": "PROSPECT"
                        },
                        {
                            "weight": 7,
                            "value": "ACTIVE"
                        },
                        {
                            "weight": 2,
                            "value": "CHURNED"
                        }
                    ]
                },
                "addresses": {
                    "_gen": "repeatedly",
                    "n": {
                        "_gen": "uniformDistribution",
                        "bounds": [
                            1,
                            5
                        ],
                        "decimals": 0
                    },
                    "target": {
                        "street": {
                            "_gen": "string",
                            "expr": "#{Address.streetName}"
                        },
                        "zipCode": {
                            "_gen": "string",
                            "expr": "#{Address.zipCode}"
                        },
                        "city": {
                            "_gen": "string",
                            "expr": "#{Address.city}"
                        },
                        "state": {
                            "_gen": "string",
                            "expr": "#{Team.state}"
                        },
                        "countryCode": {
                            "_gen": "lookup",
                            "connection": "customerDb",
                            "table": "customer.country",
                            "path": [
                                "row",
                                "code"
                            ]
                        },
                        "addressTypeId": {
                            "_gen": "lookup",
                            "connection": "customerDb",
                            "table": "customer.address_type",
                            "path": [
                                "row",
                                "id"
                            ]
                        }
                    }
                },
                "onboardedDate": {
                    "_gen": "now"
                }
            },
            "localConfigs": {
                "throttleMs": {
                    "_gen": "uniformDistribution",
                    "bounds": [
                        40000,
                        120000
                    ]
                }
            }
        }
    ],
    "schedule": {
        "stages": [
            {
                "generators": [
                    "genSegments",
                    "genPhoneTypes",
                    "genAddressTypes",
                    "genCountries"
                ]
            },
            {
                "generators": [
                    "genCustomers"
                ],
                "overrides": {
                    "genCustomers": {
                        "localConfigs": {
                            "maxEvents": 300,
                            "throttleMs": 0
                        }
                    }
                }
            },
            {
                "generators": [
                    "genCustomers"
                ]
            }
        ]
    },
    "connections": {
        "customerWebhook": {
            "kind": "webhook"
        },
        "customerDb": {
            "kind": "postgres",
            "tablePolicy": "manual",
            "connectionConfigs": {
                "host": "postgresql",
                "port": 5432,
                "username": "demo",
                "password": "abc123!",
                "schema": "customer",
                "db": "demodb"
            }
        }
    }
}
