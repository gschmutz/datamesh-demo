# Reusable shape for a Zammad User record (schema: ch.admin.zammad.avro.User)
map user {
  root.id = this.id.number()
  root.login = this.login.string()
  root.email = this.email.or("").string()
  root.firstname = this.firstname.or(null)
  root.lastname = this.lastname.or(null)
  root.image = this.image.or(null)
  root.image_source = this.image_source.or(null)
  root.department = this.department.or(null)
  root.organization_id = this.organization_id.or(null)
  root.organization_ids = this.organization_ids.or([])
  root.role_ids = this.role_ids.or([])
  root.roles = this.roles.or([])
  root.created_at = this.created_at.string()
  root.updated_at = this.updated_at.string()
  root.created_by = this.created_by.or("").string()
  root.updated_by = this.updated_by.or("").string()
  root.created_by_id = this.created_by_id.number()
  root.updated_by_id = this.updated_by_id.number()
  root.active = this.active.or(true)
  root.verified = this.verified.or(false)
  root.vip = this.vip.or(false)
  root.out_of_office = this.out_of_office.or(false)
  root.out_of_office_start_at = this.out_of_office_start_at.or(null)
  root.out_of_office_end_at = this.out_of_office_end_at.or(null)
  root.out_of_office_replacement_id = this.out_of_office_replacement_id.or(null)
  root.phone = this.phone.or("")
  root.mobile = this.mobile.or("")
  root.fax = this.fax.or("")
  root.web = this.web.or("")
  root.street = this.street.or("")
  root.city = this.city.or("")
  root.zip = this.zip.or("")
  root.country = this.country.or("")
  root.note = this.note.or("")
  root.address = this.address.or(null)
  root.source = this.source.or(null)
}

map group {
  root.id = this.id.number()
  root.name = this.name.string()
  root.name_last = this.name_last.or("").string()
  root.note = this.note.or(null)
  root.email_address_id = this.email_address_id.or(null)
  root.parent_id = this.parent_id.or(null)
  root.assignment_timeout = this.assignment_timeout.or(null)
  root.reopen_time_in_days = this.reopen_time_in_days.or(null)
  root.active = this.active.or(true)
  root.follow_up_assignment = this.follow_up_assignment.or(true)
  root.follow_up_possible = this.follow_up_possible.or("yes")
  root.shared_drafts = this.shared_drafts.or(true)
  root.signature = this.signature.or("").string()
  root.signature_id = this.signature_id.or(0).number()
  root.summary_generation = this.summary_generation.or("global_default")
  root.user_ids = this.user_ids.or([])
  root.users = this.users.or([])
  root.created_at = this.created_at.string()
  root.updated_at = this.updated_at.string()
  root.created_by = this.created_by.or("").string()
  root.updated_by = this.updated_by.or("").string()
  root.created_by_id = this.created_by_id.number()
  root.updated_by_id = this.updated_by_id.number()
}

map priority {
  root.id = this.id.number()
  root.name = this.name.string()
  root.note = this.note.or(null)
  root.ui_color = this.ui_color.or(null)
  root.ui_icon = this.ui_icon.or(null)
  root.default_create = this.default_create.or(false)
  root.active = this.active.or(true)
  root.created_at = this.created_at.string()
  root.updated_at = this.updated_at.string()
  root.created_by = this.created_by.or("").string()
  root.updated_by = this.updated_by.or("").string()
  root.created_by_id = this.created_by_id.number()
  root.updated_by_id = this.updated_by_id.number()
}

map article {
  root.id = this.id.number()
  root.ticket_id = this.ticket_id.number()
  root.body = this.body.or("").string()
  root.content_type = this.content_type.or("text/html").string()
  root.type = this.type.string()
  root.type_id = this.type_id.number()
  root.sender = this.sender.string()
  root.sender_id = this.sender_id.number()
  root.from = this.from.or(null)
  root.to = this.to.or(null)
  root.internal = this.internal.or(false)
  root.body_rendering_error = this.body_rendering_error.or(false)
  root.subject = this.subject.or(null)
  root.cc = this.cc.or(null)
  root.reply_to = this.reply_to.or(null)
  root.in_reply_to = this.in_reply_to.or(null)
  root.message_id = this.message_id.or(null)
  root.message_id_md5 = this.message_id_md5.or(null)
  root.origin_by = this.origin_by.or(null)
  root.origin_by_id = this.origin_by_id.or(null)
  root.detected_language = this.detected_language.or(null)
  root.time_unit = this.time_unit.or(null)
  root.accounted_time = this.accounted_time.or(0).number()
  root.created_by = this.created_by.apply("user")
  root.created_by_id = this.created_by_id.number()
  root.updated_by = this.updated_by.apply("user")
  root.updated_by_id = this.updated_by_id.number()
  root.created_at = this.created_at.string()
  root.updated_at = this.updated_at.string()
  root.attachments = this.attachments.or([])
  root.ai_stored_result_ids = this.ai_stored_result_ids.or([])
}

map ticket {
  root.id = this.id.number()
  root.number = this.number.string()
  root.title = this.title.string()
  root.state = this.state.string()
  root.state_id = this.state_id.number()
  root.group_id = this.group_id.number()
  root.group = this.group.apply("group")
  root.priority_id = this.priority_id.number()
  root.priority = this.priority.apply("priority")
  root.owner_id = this.owner_id.number()
  root.owner = this.owner.apply("user")
  root.customer_id = this.customer_id.number()
  root.customer = this.customer.apply("user")
  root.organization_id = this.organization_id.or(null)
  root.create_article_sender_id = this.create_article_sender_id.number()
  root.create_article_sender = this.create_article_sender.string()
  root.create_article_type_id = this.create_article_type_id.number()
  root.create_article_type = this.create_article_type.string()
  root.article_count = this.article_count.number()
  root.article_ids = this.article_ids.or([])
  root.note = this.note.or(null)
  root.type = this.type.or(null)
  root.pending_time = this.pending_time.or(null)
  root.close_at = this.close_at.or(null)
  root.escalation_at = this.escalation_at.or(null)
  root.first_response_at = this.first_response_at.or(null)
  root.first_response_escalation_at = this.first_response_escalation_at.or(null)
  root.close_escalation_at = this.close_escalation_at.or(null)
  root.update_escalation_at = this.update_escalation_at.or(null)
  root.last_contact_at = this.last_contact_at.or(null)
  root.last_contact_agent_at = this.last_contact_agent_at.or(null)
  root.last_contact_customer_at = this.last_contact_customer_at.or(null)
  root.last_owner_update_at = this.last_owner_update_at.or(null)
  root.last_close_at = this.last_close_at.or(null)
  root.first_response_in_min = this.first_response_in_min.or(null)
  root.first_response_diff_in_min = this.first_response_diff_in_min.or(null)
  root.close_in_min = this.close_in_min.or(null)
  root.close_diff_in_min = this.close_diff_in_min.or(null)
  root.update_in_min = this.update_in_min.or(null)
  root.update_diff_in_min = this.update_diff_in_min.or(null)
  root.time_unit = this.time_unit.or(null)
  root.checklist_id = this.checklist_id.or(null)
  root.ai_agent_running = this.ai_agent_running.or(false)
  root.created_at = this.created_at.string()
  root.updated_at = this.updated_at.string()
  root.created_by = this.created_by.apply("user")
  root.created_by_id = this.created_by_id.number()
  root.updated_by = this.updated_by.apply("user")
  root.updated_by_id = this.updated_by_id.number()
  root.ai_stored_result_ids = this.ai_stored_result_ids.or([])
}

# ---- assemble the ZammadTicketState record ----
map zammad_ticket_state {
  root.ticket = this.ticket.apply("ticket")
  root.article = if this.article.id.catch(null) != null { this.article.apply("article") } else { null }
}
